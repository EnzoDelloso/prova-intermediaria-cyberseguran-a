6h16l-8 8z\"/></svg>\n        </button>\n        <input type=\"hidden\" id=\"voteDownHash\" value=\"70:3:31e,16:dd3620878690cd96,10:1790553058,16:8d3dc94fbac61fd0,8:80006333,429183e40417e08f8ea7ca7a85b43e77969ed4f8a06be6f133ffc06d0bf8ae68\" />\n\n\n        \n<button class=\"js-saves-btn s-btn s-btn__unset c-pointer py4\"\n        type=\"button\"\n        id=\"saves-btn-80006333\"\n        data-controller=\"s-tooltip\"\n        data-s-tooltip-placement=\"right\"\n        data-s-popover-placement=\"\"\n        title=\"Save this question.\"\n        data-is-saved=\"false\"\n        aria-label=\"Save\"\n        data-post-id=\"80006333\"\n        data-post-type-id=\"1\"\n        data-user-privilege-for-post-click=\"0\"\n        aria-controls=\"\"\n        data-s-popover-auto-show=\"false\"\n>\n    <svg aria-hidden=\"true\" class=\"fc-theme-primary-400 js-saves-btn-selected d-none svg-icon iconBookmark\" width=\"18\" height=\"18\"  viewBox=\"0 0 18 18\"><path  d=\"M3 17V3c0-1.1.9-2 2-2h8a2 2 0 0 1 2 2v14l-6-4z\"/></svg>\n    <svg aria-hidden=\"true\" class=\"fc-black-500 js-saves-btn-unselected svg-icon iconBookmarkAlt\" width=\"18\" height=\"18\"  viewBox=\"0 0 18 18\"><path  d=\"m9 10.6 4 2.66V3H5v10.26zM3 17V3c0-1.1.9-2 2-2h8a2 2 0 0 1 2 2v14l-6-4z\"/></svg>\n</button>\n\n\n\n\n\n\n\n    \n    <a class=\"js-post-issue flex--item s-btn s-btn__unset c-pointer py6 mx-auto fc-black-500\" href=\"/posts/80006333/timeline\" data-shortcut=\"T\" data-ks-title=\"timeline\" data-controller=\"s-tooltip\" data-s-tooltip-placement=\"right\" title=\"Show activity on this post.\" aria-label=\"Timeline\"><svg aria-hidden=\"true\" class=\"mln2 mr0 svg-icon iconHistory\" width=\"19\" height=\"18\"  viewBox=\"0 0 19 18\"><path  d=\"M3 9a8 8 0 1 1 3.73 6.77L8.2 14.3A6 6 0 1 0 5 9l3.01-.01-4 4-4-4zm7-4h1.01L11 9.36l3.22 2.1-.6.93L10 10z\"/></svg></a>\n\n</div>\n\n            </div>\n\n        \n<div class=\"postcell post-layout--right\">\n\n    \n    <div class=\"s-prose js-post-body\" itemprop=\"text\">\n                \n<p>I have a very simple script that is supposed to download multiple repos simultaneously. But I am having trouble even getting one working.</p>\n<pre class=\"lang-bash prettyprint-override\"><code>$blah = Start-Job {\n    git clone https://github.com/davidalayachew/DarkestDungeonPathFinder\n}\n\nReceive-Job -Wait -Job $blah\n</code></pre>\n<p>This makes powershell throw an error, but the errors are showing the downloading logs, like <code>1% downloaded</code> , <code>2% downloaded</code>, and so on. It's almost like powershell is trying to parse the download progress messages as a command, and failing to. I tried saving the output, amongst other strategies, but nothing worked.</p>\n<p>What am I doing wrong?</p>\n    </div>\n\n            <div class=\"mt24 mb12\">\n                <div class=\"post-taglist d-flex gs4 gsy fd-column\">\n                    <div class=\"d-flex ps-relative fw-wrap\">\n                        \n                        <ul class='ml0 list-ls-none js-post-tag-list-wrapper d-inline'><li class='d-inline mr4 js-post-tag-list-item'><a href=\"/questions/tagged/powershell\" class=\"s-tag post-tag\" title=\"show questions tagged &#39;powershell&#39;\" aria-label=\"show questions tagged &#39;powershell&#39;\" rel=\"tag\" aria-describedby=\"tag-powershell-tooltip-container\" data-tag-menu-origin=\"Unknown\">powershell</a></li><li class='d-inline mr4 js-post-tag-list-item'><a href=\"/questions/tagged/start-job\" class=\"s-tag post-tag\" title=\"show questions tagged &#39;start-job&#39;\" aria-label=\"show questions tagged &#39;start-job&#39;\" rel=\"tag\" aria-describedby=\"tag-start-job-tooltip-container\" data-tag-menu-origin=\"Unknown\">start-job</a></li></ul>\n                    </div>\n                </div>\n            </div>\n\n    <div class=\"mb0 \">\n        <div class=\"mt16 d-flex gs8 gsy fw-wrap jc-end ai-start pt4 mb16\">\n            <div class=\"flex--item mr16 fl1 w96\">\n                \n\n\n<di