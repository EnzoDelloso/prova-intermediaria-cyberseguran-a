       var script = document.createElement('script');\n                        script.src = 'https://creative-assets.everesttech.net/creative/scripts/aac_viewability.js';\n                        script.onload = function() {\n                            if (window['AACViewability']) { resolve(); } else { reject(); }\n                        };\n                        script.onerror = reject;\n                        document.head.appendChild(script);\n                    });\n                };\n\n                var initAACViewability = function() {\n                    var targetEl = document.getElementById('x2_ad_x2_armr5wAAAOHb2AAx') || document.getElementById('x2_armr5wAAAOHb2AAx');\n                    try {\n                        var viewability = new (window['AACViewability'])();\n                        viewability['init']({\n                            'targetElement': targetEl,\n                            'video': false,\n                            'vimpPixelBase': 'https://stats-creative-tm.everesttech.net/vimp?cro=true&auth=789cd77539548ba30b0a76a52f60e781&iid=armr5wAAAOHb2AAx&exp=1147&aid=461869&crid=130497&adv=169061&def=false&dsp=3&dbid=36170138&dsid=10645013&daid=armr5wAAAOHb2AAx&dpid=451061592&dadid=644740187&dcid=258845576&dpp=451061592%2C&uid=armrjwACij8KzgAS&uidt=EVEREST_COOKIE_ID&rurl=https%3A%2F%2F6acd067cfbc1181a9b1f052403a5e3ba.safeframe.googlesyndication.com%2F&ua=Mozilla%2F5.0+%28Windows+NT+10.0%3B+Win64%3B+x64%3B+rv%3A156.0%29+Gecko%2F20100101+Firefox%2F156.0&tid=3471&pc=01000&m=0&c=São Paulo&reg=SP&cty=BR&dppf=t&gpf=t&ppf=f&spf=f&cst=DT_TARGETED&pids=2038812&sz=728x90&et=1790553063667',\n                            'viewabilityStandard': 'MRC'\n                        }).then(viewability['start'].bind(null));\n                    } catch(e) {\n                        fireBeacon('https://stats-creative-tm.everesttech.net/vimp?cro=true&auth=789cd77539548ba30b0a76a52f60e781&iid=armr5wAAAOHb2AAx&exp=1147&aid=461869&crid=130497&adv=16906